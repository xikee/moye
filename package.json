{
  "name": "moye",
  "version": "0.1.0",
  "private": true,
  "description": "墨页 — 安静、原生的 macOS Markdown 编辑器",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:web": "tsc --noEmit && vite build",
    "build": "npm run build:web && bash scripts/build-macos.sh",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@milkdown/crepe": "7.23.0",
    "@milkdown/kit": "7.23.0",
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}
